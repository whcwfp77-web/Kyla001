# 应用配置
NODE_ENV=development
PORT=3001
APP_NAME=语言学习平台
API_VERSION=v1

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=language_learning
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# 邮件配置（魔法链接）
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@example.com

# OpenAI配置（向量生成）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=text-embedding-ada-002

# 对象存储（AWS S3或MinIO）
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=language-learning-media

# CORS配置
CORS_ORIGIN=http://localhost:3000

# 速率限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# 功能开关
FEATURE_VECTOR_SEARCH=true
FEATURE_SHADOW_LAB=true
FEATURE_USER_SUGGESTIONS=true

# 日志配置
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# 合规配置
EMBED_WHITELIST=youtube.com,youtu.be,vimeo.com,bilibili.com
DMCA_EMAIL=dmca@example.com

# 前端URL（用于魔法链接）
FRONTEND_URL=http://localhost:3000
