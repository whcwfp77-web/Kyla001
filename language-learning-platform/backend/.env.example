# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=llp_user
DB_PASSWORD=llp_password
DB_NAME=llp_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Magic Link
MAGIC_LINK_SECRET=change-me-in-production
